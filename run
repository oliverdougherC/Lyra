#!/usr/bin/env bash
#
# Start Lyra for testing, from a known-clean state.
#
# `scripts/dev` assumes nothing is already running. This does not: it clears whatever is
# holding the ports, verifies the tooling is actually present before starting anything,
# waits for both servers to answer, and tells you which one failed if one does. Use it
# when you want to be certain you are testing the code that is on disk right now.
#
#   ./run              backend with auto-reload, frontend dev server
#   ./run --clean      also rebuild the Next cache from scratch
#   ./run --prod       production frontend build, no auto-reload
#   ./run --stop       kill everything and exit
#
# Ctrl-C stops both servers.

set -uo pipefail

cd "$(dirname "$0")"

readonly BACKEND_PORT=8000
# Not negotiable. `ALLOWED_ORIGINS` in backend/main.py allowlists port 3000 only, so a
# frontend that lands anywhere else loads fine and then fails every request with an
# opaque CORS error. Next picks the next free port silently when 3000 is taken, which is
# exactly how that trap gets sprung.
readonly FRONTEND_PORT=3000

readonly LOG_DIR="logs"
readonly BACKEND_LOG="$LOG_DIR/backend.log"
readonly FRONTEND_LOG="$LOG_DIR/frontend.log"

# How long each server gets to answer before we call it a failure and print its log.
# The frontend allowance is the larger one: a cold Next compile after --clean is slow.
readonly BACKEND_TIMEOUT=45
readonly FRONTEND_TIMEOUT=120

# Process names we are willing to kill on our ports. Anything else on 8000 or 3000 is
# somebody else's and gets reported rather than killed.
readonly OURS='node|next-server|next-router|uvicorn|[Pp]ython'

clean=0
prod=0
stop_only=0

if [ -t 1 ]; then
  bold=$(tput bold 2>/dev/null || true)
  dim=$(tput dim 2>/dev/null || true)
  red=$(tput setaf 1 2>/dev/null || true)
  green=$(tput setaf 2 2>/dev/null || true)
  yellow=$(tput setaf 3 2>/dev/null || true)
  reset=$(tput sgr0 2>/dev/null || true)
else
  bold=''; dim=''; red=''; green=''; yellow=''; reset=''
fi

say()  { printf '%s\n' "$*"; }
step() { printf '%s==>%s %s\n' "$bold" "$reset" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$*"; }
die()  { printf '%serror:%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }

# The header comment is the help text, printed from the file rather than duplicated in a
# string that would drift from it. Reads from line 3 until the comment block ends.
usage() {
  awk 'NR < 3 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit 0
}

for arg in "$@"; do
  case "$arg" in
    --clean) clean=1 ;;
    --prod)  prod=1 ;;
    --stop)  stop_only=1 ;;
    -h|--help) usage ;;
    *) die "unknown option: $arg (try --help)" ;;
  esac
done

# --- Killing what is already there ---------------------------------------------------

# Every pid listening on a port. `lsof` is on macOS by default; without it we cannot tell
# a stale server from a free port, and starting anyway would produce the silent
# wrong-port failure this script exists to prevent.
listeners_on() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | sort -u
}

describe_pid() {
  ps -p "$1" -o comm= 2>/dev/null | sed 's|.*/||'
}

# Free one port, or explain why we would not. TERM first so a dev server can flush and
# remove its own lockfiles; KILL only for what ignores it.
free_port() {
  local port="$1" label="$2" pids pid name remaining
  pids=$(listeners_on "$port")
  [ -z "$pids" ] && return 0

  for pid in $pids; do
    name=$(describe_pid "$pid")
    if ! printf '%s' "$name" | grep -Eq "$OURS"; then
      die "port $port ($label) is held by '$name' (pid $pid), which does not look like a
       Lyra server. Stop it yourself, or free the port, then run this again."
    fi
  done

  for pid in $pids; do
    kill "$pid" 2>/dev/null || true
  done

  # Give them two seconds to go quietly.
  for _ in 1 2 3 4 5 6 7 8; do
    remaining=$(listeners_on "$port")
    [ -z "$remaining" ] && break
    sleep 0.25
  done

  remaining=$(listeners_on "$port")
  if [ -n "$remaining" ]; then
    for pid in $remaining; do
      kill -9 "$pid" 2>/dev/null || true
    done
    sleep 0.5
  fi

  if [ -n "$(listeners_on "$port")" ]; then
    die "could not free port $port ($label). Something is holding it that will not die."
  fi
  ok "freed port $port ($label)"
}

stop_all() {
  step "Stopping anything already running"
  command -v lsof >/dev/null 2>&1 || die "lsof is not installed, so stale servers cannot be found."
  free_port "$BACKEND_PORT" backend
  free_port "$FRONTEND_PORT" frontend
  [ -z "$(listeners_on "$BACKEND_PORT")$(listeners_on "$FRONTEND_PORT")" ] && ok "ports are clear"
}

if [ "$stop_only" -eq 1 ]; then
  stop_all
  exit 0
fi

# --- Preflight -----------------------------------------------------------------------

step "Checking the toolchain"

# `.venv` is the project environment. `.myenv` is an older one that is missing packages;
# picking it up by accident produces import errors that look like code faults.
if [ -x .venv/bin/python ]; then
  PYTHON=.venv/bin/python
elif command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
  warn "no .venv found, falling back to system python3"
else
  die "no Python interpreter found. Create one with: python3 -m venv .venv"
fi

"$PYTHON" -c 'import fastapi, uvicorn, pymupdf, sqlite_vec' 2>/dev/null \
  || die "the backend's dependencies are not installed in $PYTHON.
       Install them with: $PYTHON -m pip install -e '.[dev]'"
ok "python: $PYTHON"

command -v pnpm >/dev/null 2>&1 || die "pnpm is not installed. See https://pnpm.io/installation"
[ -d frontend/node_modules ] \
  || die "frontend dependencies are not installed. Install them with: pnpm --dir frontend install"
ok "pnpm: $(pnpm --version)"

# --- Clearing state ------------------------------------------------------------------

stop_all

if [ "$clean" -eq 1 ]; then
  step "Clearing the Next build cache"
  # Two dev servers sharing one .next directory corrupt each other's route manifest, and
  # the symptom is a 404 on routes whose files are plainly there. Deleting it costs one
  # slow first compile and is the only reliable fix.
  rm -rf frontend/.next
  ok "removed frontend/.next"
fi

mkdir -p "$LOG_DIR" || die "could not create $LOG_DIR"
: > "$BACKEND_LOG" || die "could not write $BACKEND_LOG"
: > "$FRONTEND_LOG" || die "could not write $FRONTEND_LOG"

# --- Shutdown ------------------------------------------------------------------------

backend_pid=''
frontend_pid=''
shutting_down=0

shutdown() {
  [ "$shutting_down" -eq 1 ] && return
  shutting_down=1
  trap - INT TERM EXIT
  printf '\n'
  step "Stopping"
  for pid in $frontend_pid $backend_pid; do
    kill "$pid" 2>/dev/null || true
  done
  # Next spawns a child that does not die with its parent, so the ports are the backstop.
  sleep 1
  for port in "$FRONTEND_PORT" "$BACKEND_PORT"; do
    for pid in $(listeners_on "$port"); do
      kill -9 "$pid" 2>/dev/null || true
    done
  done
  ok "stopped"
}
trap shutdown INT TERM EXIT

# Poll a URL until it answers, or give up. Fails early and loudly if the process has
# already exited, rather than waiting out the full timeout on a server that is gone.
wait_for() {
  local url="$1" pid="$2" seconds="$3" label="$4" log="$5" waited=0
  while [ "$waited" -lt "$seconds" ]; do
    if ! kill -0 "$pid" 2>/dev/null; then
      say ''
      tail -n 25 "$log" >&2
      die "the $label exited during startup. Its last output is above."
    fi
    if curl -fsS -o /dev/null --max-time 2 "$url" 2>/dev/null; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  say ''
  tail -n 25 "$log" >&2
  die "the $label did not answer on $url within ${seconds}s. Its last output is above."
}

# --- Backend -------------------------------------------------------------------------

step "Starting the backend"
# Written out twice rather than assembled from an array: macOS ships bash 3.2, where
# expanding an empty array under `set -u` is an unbound-variable error.
if [ "$prod" -eq 1 ]; then
  "$PYTHON" -m uvicorn backend.main:app \
    --host 127.0.0.1 --port "$BACKEND_PORT" >>"$BACKEND_LOG" 2>&1 &
else
  "$PYTHON" -m uvicorn backend.main:app \
    --host 127.0.0.1 --port "$BACKEND_PORT" --reload >>"$BACKEND_LOG" 2>&1 &
fi
backend_pid=$!

# `/api/settings` is the readiness probe: it opens the database, which means migrations
# have run. A port that merely accepts connections would not prove that.
wait_for "http://127.0.0.1:$BACKEND_PORT/api/settings" "$backend_pid" \
  "$BACKEND_TIMEOUT" "backend" "$BACKEND_LOG"
ok "backend ready on http://127.0.0.1:$BACKEND_PORT"

# --- Frontend ------------------------------------------------------------------------

step "Starting the frontend"
if [ "$prod" -eq 1 ]; then
  say "  ${dim}building...${reset}"
  if ! pnpm --dir frontend build >>"$FRONTEND_LOG" 2>&1; then
    tail -n 30 "$FRONTEND_LOG" >&2
    die "the production build failed. Its last output is above."
  fi
  ok "built"
  pnpm --dir frontend start --port "$FRONTEND_PORT" >>"$FRONTEND_LOG" 2>&1 &
else
  pnpm --dir frontend dev --port "$FRONTEND_PORT" >>"$FRONTEND_LOG" 2>&1 &
fi
frontend_pid=$!

wait_for "http://localhost:$FRONTEND_PORT" "$frontend_pid" \
  "$FRONTEND_TIMEOUT" "frontend" "$FRONTEND_LOG"

# The ports were cleared above, so this should never trip. It is checked anyway because
# the failure it catches is invisible from the browser: the app renders and every request
# is refused by CORS.
if ! grep -qE "localhost:$FRONTEND_PORT" "$FRONTEND_LOG"; then
  warn "the frontend log does not mention port $FRONTEND_PORT. If requests fail with CORS"
  warn "errors, it landed on another port; stop it and run ./run again."
fi
ok "frontend ready on http://localhost:$FRONTEND_PORT"

# --- Running -------------------------------------------------------------------------

say ''
say "  ${bold}Lyra is running${reset}"
say "  app      http://localhost:$FRONTEND_PORT"
say "  api      http://127.0.0.1:$BACKEND_PORT"
say "  logs     $BACKEND_LOG, $FRONTEND_LOG"
say ''
say "  ${dim}Ctrl-C to stop both.${reset}"
say ''

# Follow both logs so the terminal behaves like `scripts/dev`, while the files keep the
# whole history for the failure paths above.
tail -n 0 -f "$BACKEND_LOG" "$FRONTEND_LOG" &
tail_pid=$!

# Exit as soon as either server does, rather than sitting on a half-dead stack.
while kill -0 "$backend_pid" 2>/dev/null && kill -0 "$frontend_pid" 2>/dev/null; do
  sleep 1
done

kill "$tail_pid" 2>/dev/null || true
warn "a server exited on its own; shutting the other one down"
