#!/usr/bin/env bash
# Lyra's one-command local application launcher.
#
#   ./run                       provision and start the production-like app
#   ./run --dev                 start hot-reloading development servers
#   ./run stop                  stop only processes started by this launcher
#   ./run backup --archive ...  create a stopped, consistent data backup
#   ./run restore ...           restore one backup into explicit target paths
#   ./run status|doctor|logs    inspect the local installation
#
# The Python implementation is intentionally kept out of this shim so its ownership,
# preflight, and readiness behavior can be regression-tested.

set -euo pipefail

cd "$(dirname "$0")"

if command -v python3 >/dev/null 2>&1; then
  exec python3 scripts/lyra_launcher.py "$@"
fi

printf 'error: Python 3.12 or newer is required to run Lyra.\n' >&2
printf 'Install Python, then run this command again.\n' >&2
exit 1
