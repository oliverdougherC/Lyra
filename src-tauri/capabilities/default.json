{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for Lyra's bundled desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-desktop-bootstrap",
    "allow-retry-backend",
    "allow-open-external-url",
    "allow-pick-import-directory",
    "allow-publish-desktop-import"
  ]
}
