  "before": {
    "draft": {
      "id": 1,
      "class_id": 1,
      "kind": "draft",
      "title": "review_seeded_claim_and_duplicates",
      "state": "ready",
      "stage_detail": null,
      "problems_total": null,
      "problems_done": 0,
